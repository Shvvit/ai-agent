# Default local provider
AI_PROVIDER=ollama
AI_MODEL=qwen3:8b
AI_HOST=http://127.0.0.1:11434
AI_TEMPERATURE=0.2
AI_TIMEOUT=120

# OpenRouter example (uncomment and set your own key)
